{
  "analysis": "paired_patient_level_bootstrap",
  "seed": 631,
  "replicates": 1000,
  "attempts": 1000,
  "single_class_draws_skipped": 0,
  "sampling_unit": "patient",
  "stratification": "frozen_development_fold",
  "patients_per_fold": {
    "1": 17,
    "2": 16,
    "3": 16
  },
