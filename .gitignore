# =========================================================
# CIS 631 BREAST HISTOPATHOLOGY RESEARCH
# =========================================================


# ---------------------------------------------------------
# DATASETS
#
# Do NOT upload BreakHis, BACH, BRACS, or any derived
# histopathology image datasets to GitHub.
# ---------------------------------------------------------

data/*
datasets/*
raw_data/*
processed_data/*


# Allow documentation / placeholder files inside data folders

!data/README.md
!data/.gitkeep

!datasets/README.md
!datasets/.gitkeep


# ---------------------------------------------------------
# Specific dataset directories
# ---------------------------------------------------------

BreakHis/
breakhis/

BACH/
bach/

BRACS/
bracs/


# ---------------------------------------------------------
# Large histopathology / whole-slide image formats
# ---------------------------------------------------------

*.tif
*.tiff
*.svs
*.ndpi
*.mrxs


# IMPORTANT:
# Do NOT globally ignore PNG, JPG, JPEG, or CSV files.
# We want to track figures and small result files.
#
# Dataset images should instead remain inside ignored
# data/ or dataset-specific folders.


# =========================================================
# MODEL CHECKPOINTS / TRAINED WEIGHTS
# =========================================================

checkpoints/
weights/
models/

*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5


# =========================================================
# TRAINING OUTPUTS / EXPERIMENT LOGS
# =========================================================

runs/
wandb/
lightning_logs/
tensorboard/
logs/


# =========================================================
# TEMPORARY / CACHE FILES
# =========================================================

tmp/
temp/
cache/


# =========================================================
# LOCAL CONFIGURATION FILES
# =========================================================

config.local.yaml
config.local.yml
config.local.json


# =========================================================
# OPTIONAL LARGE OUTPUT FILES
#
# Keep small result CSVs and figures in GitHub.
# Ignore large binary outputs if generated later.
# =========================================================

*.npy
*.npz
*.pkl
*.pickle


# =========================================================
# End of project-specific exclusions
